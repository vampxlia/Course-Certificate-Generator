<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Create Template</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>

<h1>Create Template</h1>
<p><a href="/templates">Back to Templates</a></p>

<div class="template-form-container">

<form action="/templates/create" method="POST" class="template-form" id="templateForm">

    <div class="section">
        <h2>Template Information</h2>
        <div class="field-group">
            <label>Name</label>
            <input type="text" name="name" required placeholder="My Certificate Template">
        </div>
        <div class="field-group">
            <label>Course</label>
            <select name="courseId" id="courseId" required class="course-select">
                <option value="">-- Select a course --</option>
                <% (courses || []).forEach(function(course) { %>
                    <option value="<%= course.id %>"><%= course.name %></option>
                <% }); %>
            </select>
        </div>
    </div>

    <div class="section">
        <h2>Page Settings</h2>
        <div class="field-group">
            <label>Background</label>
            <input type="color" name="backgroundColor" value="#dbf2ff">
            <label>Border Color</label>
            <input type="color" name="borderColor" value="#2655b5">
            <label>Border Width</label>
            <input type="number" name="borderWidth" value="20" min="0">
        </div>
    </div>

    <div class="section">
        <h2>Title</h2>
        <div class="field-group">
            <label>Text</label>
            <input type="text" name="titleText" placeholder="Certificate">
        </div>
        <div class="field-group">
            <label>X</label>
            <input type="number" name="titleX" placeholder="700">
            <label>Y</label>
            <input type="number" name="titleY" placeholder="100">
            <label>Font Size</label>
            <input type="number" name="titleFontSize" placeholder="60">
            <label>Font</label>
            <input type="text" name="titleFontFamily" placeholder="Impact">
            <label>Color</label>
            <input type="color" name="titleColor" value="#2655b5">
        </div>
    </div>

    <div class="section">
        <h2>Intro Text</h2>
        <div class="field-group">
            <label>Text</label>
            <input type="text" name="introText" placeholder="It is hereby certified that">
        </div>
        <div class="field-group">
            <label>X</label>
            <input type="number" name="introX" placeholder="700">
            <label>Y</label>
            <input type="number" name="introY" placeholder="250">
            <label>Font Size</label>
            <input type="number" name="introFontSize" placeholder="30">
            <label>Font</label>
            <input type="text" name="introFontFamily" placeholder="Haettenschweiler">
            <label>Color</label>
            <input type="color" name="introColor" value="#2655b5">
        </div>
    </div>

    <div class="section">
        <h2>Student Name</h2>
        <div class="field-group">
            <label>X</label>
            <input type="number" name="studentNameX" placeholder="700">
            <label>Y</label>
            <input type="number" name="studentNameY" placeholder="330">
            <label>Font Size</label>
            <input type="number" name="studentNameFontSize" placeholder="30">
            <label>Font</label>
            <input type="text" name="studentNameFontFamily" placeholder="Arial Narrow Bold">
            <label>Color</label>
            <input type="color" name="studentNameColor" value="#2655b5">
        </div>
    </div>

    <div class="section">
        <h2>Main Text</h2>
        <div class="field-group">
            <label>Text</label>
        </div>
        <textarea
            name="mainText"
            rows="4"
            class="textarea-full"
            placeholder="student with ID: {{id}} completed the course {{curso}}. The course started on {{data_inicio}} and ended on {{data_fim}}."
        ></textarea>
        <div class="field-group field-group-mt">
            <label>X</label>
            <input type="number" name="mainTextX" placeholder="700">
            <label>Y</label>
            <input type="number" name="mainTextY" placeholder="450">
            <label>Font Size</label>
            <input type="number" name="mainTextFontSize" placeholder="20">
            <label>Font</label>
            <input type="text" name="mainTextFontFamily" placeholder="Arial Narrow Bold">
            <label>Color</label>
            <input type="color" name="mainTextColor" value="#2655b5">
        </div>
    </div>

    <div class="section">
        <h2>Congratulations</h2>
        <div class="field-group">
            <label>Text</label>
            <input type="text" name="congratulationsText" placeholder="Congratulations!">
        </div>
        <div class="field-group">
            <label>X</label>
            <input type="number" name="congratulationsX" placeholder="700">
            <label>Y</label>
            <input type="number" name="congratulationsY" placeholder="650">
            <label>Font Size</label>
            <input type="number" name="congratulationsFontSize" placeholder="50">
            <label>Font</label>
            <input type="text" name="congratulationsFontFamily" placeholder="Haettenschweiler">
            <label>Color</label>
            <input type="color" name="congratulationsColor" value="#2655b5">
        </div>
    </div>

    <div class="section">
        <h2>Signature</h2>
        <div class="field-group">
            <label>Text</label>
            <input type="text" name="signatureText" placeholder="Responsible Party Signature">
        </div>
        <div class="field-group">
            <label>X</label>
            <input type="number" name="signatureX" placeholder="1200">
            <label>Y</label>
            <input type="number" name="signatureY" placeholder="900">
            <label>Font Size</label>
            <input type="number" name="signatureFontSize" placeholder="30">
            <label>Font</label>
            <input type="text" name="signatureFontFamily" placeholder="Arial Narrow Bold">
            <label>Color</label>
            <input type="color" name="signatureColor" value="#2655b5">
        </div>
    </div>

    <div class="section" id="imagesSection">
        <h2>Images</h2>
        <div id="imagesContainer">
            <!-- Dynamic images will be rendered here -->
        </div>
        <button type="button" class="primary-btn btn-margin-top" id="addImageBtn">
            Add Image
        </button>
        <input type="hidden" name="imagesJson" id="imagesJson" value="">
    </div>

    <button type="submit" class="success-btn">
        Create Template
    </button>
    <button type="button" class="primary-btn btn-margin-left" id="previewBtn">
        Preview
    </button>

</form>

<div class="template-preview-panel">
    <h2>Preview</h2>
    <iframe id="previewFrame" srcdoc="<p style='padding:1rem;color:#999;'>Click 'Preview' to see your certificate.</p>"></iframe>
</div>

</div>

<script>
(function() {
    const form = document.getElementById('templateForm');
    const previewBtn = document.getElementById('previewBtn');
    const previewFrame = document.getElementById('previewFrame');

    // Images Editor Logic
    const imagesContainer = document.getElementById('imagesContainer');
    const addImageBtn = document.getElementById('addImageBtn');
    const imagesJsonInput = document.getElementById('imagesJson');

    let images = [];

    function renderImages() {
        imagesContainer.innerHTML = '';
        images.forEach((image, index) => {
            const div = document.createElement('div');
            div.className = 'field-group image-card';

            div.innerHTML = `
                <div class="image-card-header">
                    <strong>Image #${index + 1}</strong>
                    <button type="button" class="danger-btn image-card-remove">Remove</button>
                </div>
                <div class="image-card-body">
                    <div class="image-card-src-col">
                        <label class="image-card-src-label">Image Source (URL or Upload File below)</label>
                        <input type="text" class="image-src image-card-src-input" value="${image.src || ''}" placeholder="http://example.com/logo.png">
                        <input type="file" class="image-file image-card-file" accept="image/*">
                    </div>
                    <div class="image-card-thumb">
                        <img src="${image.src || ''}" class="image-preview" style="max-width: 100%; max-height: 100%; display: ${image.src ? 'block' : 'none'};">
                        <span class="image-placeholder image-card-placeholder" style="display: ${image.src ? 'none' : 'block'};">No Image</span>
                    </div>
                </div>
                <div class="image-card-coords">
                    <label class="image-coord-label">X:</label>
                    <input type="number" class="image-x image-coord-input" value="${image.x || 100}">
                    <label class="image-coord-label">Y:</label>
                    <input type="number" class="image-y image-coord-input" value="${image.y || 100}">
                    <label class="image-coord-label">Width:</label>
                    <input type="number" class="image-width image-coord-input" value="${image.width || 150}">
                    <label class="image-coord-label">Height:</label>
                    <input type="number" class="image-height image-coord-input" value="${image.height || 150}">
                </div>
            `;

            const removeBtn = div.querySelector('.danger-btn');
            removeBtn.addEventListener('click', () => {
                images.splice(index, 1);
                renderImages();
                updateHiddenInput();
            });

            const srcInput = div.querySelector('.image-src');
            const fileInput = div.querySelector('.image-file');
            const previewImg = div.querySelector('.image-preview');
            const placeholderSpan = div.querySelector('.image-placeholder');

            srcInput.addEventListener('input', (e) => {
                image.src = e.target.value;
                if (image.src) {
                    previewImg.src = image.src;
                    previewImg.style.display = 'block';
                    placeholderSpan.style.display = 'none';
                } else {
                    previewImg.style.display = 'none';
                    placeholderSpan.style.display = 'block';
                }
                updateHiddenInput();
            });

            fileInput.addEventListener('change', (e) => {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function(evt) {
                        const base64 = evt.target.result;
                        srcInput.value = base64;
                        image.src = base64;
                        previewImg.src = base64;
                        previewImg.style.display = 'block';
                        placeholderSpan.style.display = 'none';
                        updateHiddenInput();
                    };
                    reader.readAsDataURL(file);
                }
            });

            ['x', 'y', 'width', 'height'].forEach(prop => {
                const input = div.querySelector(`.image-${prop}`);
                input.addEventListener('input', (e) => {
                    image[prop] = parseInt(e.target.value, 10) || 0;
                    updateHiddenInput();
                });
            });

            imagesContainer.appendChild(div);
        });
    }

    function updateHiddenInput() {
        imagesJsonInput.value = JSON.stringify(images);
    }

    addImageBtn.addEventListener('click', () => {
        images.push({
            id: 'image_' + Date.now() + '_' + Math.floor(Math.random() * 1000),
            type: 'image',
            src: '',
            x: 100,
            y: 100,
            width: 150,
            height: 150
        });
        renderImages();
        updateHiddenInput();
    });

    renderImages();
    updateHiddenInput();

    previewBtn.addEventListener('click', async function() {
        updateHiddenInput();
        const formData = new FormData(form);
        const params = new URLSearchParams();
        for (const [key, value] of formData.entries()) {
            params.append(key, value);
        }

        try {
            const response = await fetch('/templates/preview', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString(),
            });
            const html = await response.text();
            previewFrame.srcdoc = html;
        } catch (err) {
            previewFrame.srcdoc = '<p style="color:red;padding:1rem;">Error loading preview.</p>';
        }
    });

    form.addEventListener('submit', updateHiddenInput);
})();
</script>

</body>
</html>
