<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Generate Certificates</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
<div class="card">
    <h1>Generate Certificates</h1>
    <p><a href="/">Back to Dashboard</a></p>

    <% if (successMessage) { %> <div class="success"><%= successMessage %></div> <% } %>
    <% if (typeof errorMessage !== 'undefined' && errorMessage) { %> <div class="error"><%= errorMessage %></div> <% } %>

    <div class="filter-bar">
        <form action="/certificates/generate" method="GET">
            <label>Course:</label>
            <select name="courseId">
                <option value="">All Courses</option>
                <% courses.forEach(course => { %>
                    <option value="<%= course.id %>" <%= filters.courseId === course.id ? 'selected' : '' %>>
                        <%= course.name %>
                    </option>
                <% }) %>
            </select>

            <label>Year:</label>
            <input type="number" name="year" placeholder="e.g., 2024" value="<%= filters.year || '' %>">

            <button type="submit">Apply Filters</button>
            <a href="/certificates/generate">Clear All</a>
        </form>

        <% if (filters.courseId || filters.year) { %>
        <div class="active-filters">
            <span style="font-weight: 600;">Active Filters:</span>
            <% if (filters.courseId) { 
                const courseName = courses.find(c => c.id === filters.courseId)?.name || filters.courseId;
            %>
                <a href="?year=<%= filters.year || '' %>" class="filter-chip">Course: <%= courseName %> &times;</a>
            <% } %>
            <% if (filters.year) { %>
                <a href="?courseId=<%= filters.courseId || '' %>" class="filter-chip">Year: <%= filters.year %> &times;</a>
            <% } %>
        </div>
        <% } %>
    </div>

    <form method="POST">
        <div class="template-select-bar">
            <label class="template-select-label">Select Template (For Generation):</label>
            <select name="templateId" class="template-select">
                <option value="">-- Choose a template --</option>
                <% templates.forEach(tpl => { %>
                    <option value="<%= tpl.id %>"><%= tpl.name %> (ID: <%= tpl.id %>)</option>
                <% }) %>
            </select>
            <% if (templates.length === 0) { %>
                <span class="template-missing-warning">
                    No templates found. Please <a href="/templates/create" class="template-missing-link">Create a template first</a>.
                </span>
            <% } %>
        </div>

        <table>
            <thead>
            <tr>
                <th><input type="checkbox" id="selectAll" title="Select all filtered students"></th>
                <th>Student Name</th>
                <th>Email</th>
                <th>Course</th>
                <th>Status</th>
            </tr>
            </thead>
            <tbody>
            <% if (students.length === 0) { %>
                <tr><td colspan="5">No eligible students found.</td></tr>
            <% } %>

            <% students.forEach(student => { %>
                <tr>
                    <td><input type="checkbox" name="studentIds" value="<%= student.id %>" class="student-checkbox" data-has-pdf="<%= student.hasPdf %>"></td>
                    <td><%= student.name %></td>
                    <td><%= student.email %></td>
                    <td><%= student.course.name %></td>
                    <td>
                        <% if (student.hasPdf) { %>
                            <span class="badge success-badge">PDF Ready</span>
                        <% } else { %>
                            <span class="badge secondary-badge">Not Generated</span>
                        <% } %>
                    </td>
                </tr>
            <% }) %>
            </tbody>
        </table>

        <% if (students.length > 0) { %>
            <div class="action-buttons">
                <button type="submit" class="success-btn" formaction="/certificates/generate" id="generateBtn">
                    Generate Selected Certificates
                </button>
                <button type="submit" class="primary-btn" formaction="/certificates/email" id="emailBtn">
                    Email Selected Students
                </button>
            </div>
        <% } %>
    </form>

    <% if (students.length > 0) { %>
    <div class="pagination-controls">
        <button id="prevBtn" onclick="changePage(-1)" class="schedule-btn">← Previous</button>
        <span id="page-info" class="pagination-info"></span>
        <button id="nextBtn" onclick="changePage(1)" class="schedule-btn">Next →</button>
        <span id="count-info" class="pagination-count"></span>
    </div>
    <% } %>

</div>
<script>
    (function(){
        const PAGE_SIZE = 15;
        let currentPage = 1;

        // Tag all data rows first
        document.querySelectorAll('tbody tr').forEach((row, i) => row.setAttribute('data-row', i));

        const allRows = Array.from(document.querySelectorAll('tbody tr[data-row]'));
        const totalRows = allRows.length;
        const totalPages = Math.ceil(totalRows / PAGE_SIZE);

        function renderPage(page) {
            currentPage = Math.max(1, Math.min(page, totalPages));
            const start = (currentPage - 1) * PAGE_SIZE;
            const end = start + PAGE_SIZE;

            allRows.forEach((row, i) => {
                row.style.display = (i >= start && i < end) ? '' : 'none';
            });

            const pageInfo = document.getElementById('page-info');
            const countInfo = document.getElementById('count-info');
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');

            if (pageInfo) pageInfo.textContent = `Page ${currentPage} of ${totalPages}`;
            if (countInfo) countInfo.textContent = `(${totalRows} students total)`;
            if (prevBtn) prevBtn.disabled = currentPage === 1;
            if (nextBtn) nextBtn.disabled = currentPage === totalPages || totalPages === 0;
        }

        window.changePage = function(delta) {
            renderPage(currentPage + delta);
        };

        const selectAll = document.getElementById('selectAll');
        if (selectAll) {
            selectAll.addEventListener('change', (e) => {
                const checked = e.target.checked;
                // Only select/deselect visible rows on the current page
                allRows.forEach(row => {
                    if (row.style.display !== 'none') {
                        const cb = row.querySelector('.student-checkbox');
                        if (cb) cb.checked = checked;
                    }
                });
            });
        }

        if (totalPages > 0) renderPage(1);
    })();
</script>
</body>
</html>